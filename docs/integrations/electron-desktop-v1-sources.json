    {
      "id": "EL_PROCESS",
      "url": "https://www.electronjs.org/docs/latest/tutorial/process-model",
      "facts": "Main/renderer/utility process responsibilities; utility runs Node and supports message ports."
    },
    {
      "id": "EL_UTILITY",
      "url": "https://www.electronjs.org/docs/latest/api/utility-process",
      "facts": "utilityProcess.fork after app readiness; Node child plus message ports; native library privilege option is explicit and disabled by default."
    },
    {
      "id": "EL_SECURITY",
      "url": "https://www.electronjs.org/docs/latest/tutorial/security/",
      "facts": "Renderer isolation/sandbox, constrained privilege/IPC/navigation, custom protocols preferred over file scheme."
    },
    {
      "id": "EL_CONTEXT",
      "url": "https://www.electronjs.org/docs/latest/tutorial/context-isolation",
      "facts": "Context isolation separates preload authority from page; narrow bridge required."
    },
    {
      "id": "EL_ESM",
      "url": "https://www.electronjs.org/docs/latest/tutorial/esm",
      "facts": "Main supports Node ESM; sandboxed preload does not support ESM imports; bundle/use CJS preload rather than removing sandbox."
    },
    {
      "id": "EL_NATIVE",
      "url": "https://www.electronjs.org/docs/latest/tutorial/using-native-node-modules",
      "facts": "Electron/native ABI compatibility and rebuild; Forge uses electron-rebuild; validate chosen platform/architecture."
    },
    {
      "id": "FORGE_UNPACK",
      "url": "https://www.electronforge.io/config/plugins/auto-unpack-natives",
      "facts": "Auto-unpack-natives configures native modules outside ASAR when ASAR enabled."
    },
    {
      "id": "FORGE_VITE",
      "url": "https://www.electronforge.io/config/plugins/vite",
      "facts": "Forge Vite plugin explicitly experimental and minor versions may break; retaining current Vite build via hooks is a recommendation."
    },
    {
      "id": "EL_PROTOCOL",
      "url": "https://www.electronjs.org/docs/latest/api/protocol",
      "facts": "Protocol belongs to Electron session; standard/secure/fetch privileges and streaming support; safe resource mapping remains app responsibility."
    },
    {
      "id": "EL_APP",
      "url": "https://www.electronjs.org/docs/latest/api/app",
      "facts": "userData/sessionData paths; requestSingleInstanceLock scope; quit/window lifecycle differs and must be handled."
    },
    {
      "id": "FORGE_MAC_SIGN",
      "url": "https://www.electronforge.io/guides/code-signing/code-signing-macos",
      "facts": "Direct macOS distribution signing/notarization, Forge config and protecting credentials."
    },
    {
      "id": "EL_UPDATE",
      "url": "https://www.electronjs.org/docs/latest/api/auto-updater",
      "facts": "Built-in autoUpdater macOS/Windows only; macOS signing requirement; Linux platform strategy separate."
    }

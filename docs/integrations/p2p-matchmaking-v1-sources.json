  "officialReferences": [
    {
      "id": "HS1",
      "url": "https://docs.pears.com/p2p/reference/building-blocks/hyperswarm/",
      "facts": "32-byte topic discovery, one swarm/multiple topics, encrypted sockets, relayThrough fallback, bounded peer options; presence directory semantics are application responsibilities."
    },
    {
      "id": "DHT1",
      "url": "https://docs.pears.com/p2p/reference/building-blocks/hyperdht/",
      "facts": "Public-key-addressed encrypted connections, bootstrap and server/connection options. Root retrieval documented against 6.37.0; use the tested lockfile rather than assuming latest-source compatibility."
    },
    {
      "id": "DHT2",
      "url": "https://github.com/holepunchto/hyperdht/blob/7b56e0442814583fd77602462e0eae3c546e17c6/README.md",
      "facts": "Defaults public commons bootstrap; isolated networks require persistent node; UDP hole-punching works on most networks."
    },
    {
      "id": "HC1",
      "url": "https://docs.pears.com/p2p/reference/building-blocks/hypercore/",
      "facts": "Append-only log, sparse verified reads, optional block encryption, fork/truncate APIs, signed payload contains key/treeHash/length/fork."
    },
    {
      "id": "CS1",
      "url": "https://docs.pears.com/p2p/reference/helpers/corestore/",
      "facts": "Named core derivation, shared replication, namespaces; namespaces are not peer ACL."
    },
    {
      "id": "CS2",
      "url": "https://docs.pears.com/p2p/how-to/store-and-replicate/work-with-many-hypercores-using-corestore/",
      "facts": "Corestore does not exchange read keys; loaded cores co-replicate; get(timeout) waits for blocks while discovery/update alone is insufficient."
    },
    {
      "id": "PM1",
      "url": "https://docs.pears.com/p2p/reference/helpers/protomux/",
      "facts": "Versioned message-oriented channels over a framed encrypted stream, supports compact-encoding; suitable control channel."
    },
    {
      "id": "RPC1",
      "url": "https://github.com/holepunchto/rpc/blob/12e4494365759a3afe3c44b94621233903317743/README.md",
      "facts": "@hyperswarm/rpc over DHT+Protomux; reusable existing DHT; remote key available; request/reply optional not required for match durable feeds."
    },
    {
      "id": "RELAY1",
      "url": "https://docs.pears.com/p2p/how-to/connect-to-peers/relay-connections-through-a-blind-relay/",
      "facts": "Third reachable relay host, direct-first fallback, persistent relay key/service, packet forwarding not data retention."
    },
    {
      "id": "RELAY2",
      "url": "https://github.com/holepunchto/blind-relay",
      "facts": "UDX over Protomux relay; pairing tokens, active/cumulative counters."
    },
    {
      "id": "RELAY3",
      "url": "https://github.com/holepunchto/blind-relay-service/blob/7c8d9ec37b6f6ca269cd7717d9de5f75e71d186b/bin.mjs",
      "facts": "Node CLI storage and port options, Corestore-derived stable relay key, operational metrics; GitHub connector direct source."
    },
    {
      "id": "OLDRELAY",
      "url": "https://github.com/holepunchto/hyperswarm-dht-relay/blob/main/README.md",
      "facts": "@hyperswarm/dht-relay explicitly experimental, says not production."
    },
    {
      "id": "AVAIL1",
      "url": "https://docs.pears.com/pear/explanation/availability-and-blind-peering/",
      "facts": "Offline data availability needs at least one live seeder."
    },
    {
      "id": "BLIND1",
      "url": "https://docs.pears.com/p2p/how-to/blind-peering/keep-data-available-with-blind-peering/",
      "facts": "blind-peering client uses existing swarm/store; blind-peer server/CLI retains cores; independent of UI."
    },
    {
      "id": "HB1",
      "url": "https://docs.pears.com/p2p/reference/building-blocks/hyperbee/",
      "facts": "Sorted append-only B-tree backed by one core; batch/range/snapshot materialized indexes."
    },
    {
      "id": "AB1",
      "url": "https://docs.pears.com/p2p/reference/building-blocks/autobase/",
      "facts": "Multiwriter causal ordering; may reorder previously seen records; pure deterministic apply."
    },
    {
      "id": "NATIVE1",
      "url": "https://github.com/holepunchto/rocksdb-native",
      "facts": "Native RocksDB binding; Linux requires libatomic; package includes prebuilds but target install must be verified."
    },
    {
      "id": "IP1",
      "url": "https://docs.pears.com/p2p/explanation/peer-to-peer-demystified/",
      "facts": "Peer IP exposure on direct connections; encryption distinct from anonymity; NAT traversal is not universal."
    }

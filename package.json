{
  "name": "hapa-versus",
  "version": "0.1.0",
  "private": true,
  "description": "Hapa Versus: a two-player tactical Card battlefield on a 2.5D Luminati diorama. Territory mints public Minor Arcana that become Supply, Mana or Card abilities; formations meet member by member.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/hapa/*.test.js",
    "check": "node tools/hapa/check.mjs",
    "match": "node tools/hapa/match.mjs",
    "experiment": "node tools/hapa/experiment.mjs",
    "replay": "node tools/hapa/replay.mjs",
    "peers": "node tools/hapa/peers.mjs",
    "art:sync": "node tools/hapa/sync-tarot-art.mjs",
    "history": "node tools/hapa/history.mjs",
    "play": "electron-forge start",
    "desktop:package": "electron-forge package --arch=arm64",
    "desktop:make": "electron-forge make --arch=arm64",
    "desktop:smoke": "node tools/hapa/desktop-smoke.mjs",
    "lobby:serve": "node tools/hapa/lobby-serve.mjs",
    "online": "node tools/hapa/online.mjs"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "compact-encoding": "3.7.1",
    "fs-native-extensions": "1.5.4",
    "hypercore": "^11.40.4",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "4.17.2",
    "protomux": "3.13.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "electron": "45.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  },
  "productName": "Hapa Versus",
  "main": "desktop/main.mjs",
  "author": "Hapa"
}
